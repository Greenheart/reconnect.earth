{
  "name": "reconnect.earth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "update-lifewheel": "sh scripts/update-lifewheel.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fix": "prettier -l --write ."
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/el-messiri": "^5.3.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/lucide": "^1.2.133",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/enhanced-img": "1.0.0-next.5",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "type": "module",
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "dependencies": {
    "@comark/svelte": "^0.7.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@sveltia/cms": "0.212.1",
    "sveltekit-search-params": "^4.0.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.4.2",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#assets/": "./src/assets",
    "#assets/*": "./src/assets/*",
    "#data": "./src/data",
    "#data/*": "./src/data/*"
  }
}
