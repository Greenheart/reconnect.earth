{
  "name": "reconnect.earth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "update-lifewheel": "sh scripts/update-lifewheel.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fix": "prettier -l --write ."
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/el-messiri": "^5.3.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1"
  },
  "type": "module",
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "dependencies": {
    "sveltekit-search-params": "^4.0.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.21.0"
}
